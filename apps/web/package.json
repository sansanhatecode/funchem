{
  "name": "@funchem/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "e2e": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_API_URL=http://localhost:4100 NEXT_PUBLIC_ENABLE_DEV_PAGES=1 next build && playwright test",
    "e2e:only": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@funchem/api-client": "workspace:*",
    "@funchem/chem-ui": "workspace:*",
    "@funchem/content": "workspace:*",
    "@funchem/core": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "^1.7.25",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
